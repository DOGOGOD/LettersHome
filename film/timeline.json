  {
   "id": "c3_letter",
   "builder": "c3_letter",
   "start": 322.873,
   "dur": 11.644,
   "p": {},
   "tin": {
    "type": "dissolve",
    "dur": 0.9
   },
   "lines": [
    {
     "text": "Ma bien chère Lucie,",
     "start": -11.714,
     "end": -10.168
    },
    {
     "text": "Quand cette lettre te parviendra, je serai mort fusillé.",
     "start": -9.218,
     "end": -6.147
    },
    {
     "text": "Je ne suis pas plus coupable que les autres, mais il faut un exemple.",
     "start": -4.897,
     "end": -1.5
    },
    {
     "text": "Je te fais mes derniers adieux à la hâte, les larmes aux yeux, l'âme en peine.",
     "start": 0.35,
     "end": 5.699
    },
    {
     "text": "Je te demande à genoux humblement pardon pour toute la peine que je vais te causer.",
     "start": 6.549,
     "end": 10.644
    },
    {
     "text": "Je meurs innocent.",
     "start": 12.494,
     "end": 13.787
    },
    {
     "text": "Ma dernière pensée, à toi, jusqu'au bout.",
     "start": 15.237,
     "end": 18.703
    }
   ]
  },
